{
  "name": "smarterp",
  "private": true,
  "version": "0.0.0",
  "description": "smarterp — Fibu app (frontend + Node.js/MariaDB backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w @smarterp/frontend",
    "dev:backend": "npm run dev -w @smarterp/backend",
    "build": "npm run build -w @smarterp/frontend && npm run build -w @smarterp/backend",
    "lint": "npm run lint -w @smarterp/frontend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "npm run migrate -w @smarterp/backend"
  }
}
