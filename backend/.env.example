# Backend-Konfiguration — kopiere diese Datei nach `.env` und passe die Werte an.
# `.env` ist in .gitignore ausgeschlossen und darf nicht committet werden.

# HTTP
PORT=3001
HOST=0.0.0.0

# MariaDB (Standardwerte passen zum mitgelieferten docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smarterp
DB_PASSWORD=smarterp
DB_NAME=smarterp
